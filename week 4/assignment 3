# 1a
def convert_units(choice, values_list):
    for val in values_list:
        if type(val) != int and type(val) != float:
            print("Error:", val, "is not a valid number.")
        elif choice == "1":  # kpl to mpg
            result = val * 2.35215
            print(val, "kpl =", round(result, 2), "mpg")
        elif choice == "2":  # mpg to kpl
            result = val / 2.35215
            print(val, "mpg =", round(result, 2), "kpl")

