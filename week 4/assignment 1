# 1c
my_tuple2 = (1, 2, 3, 4, 3, 2, 1, 2, 3, 5, 4, 3, 2, 1)

counts = {}
for num in my_tuple2:
    if num in counts:
        counts[num] += 1
    else:
        counts[num] = 1

for num, count in counts.items():
    if count > 1:
        print("Integer", num, "appears", count, "times.")

