# 1d
my_list_ten = [5, 8, "hi", 10, False, 20, 18, "hi", 20, True]

my_list_ten_mem = [id(item) for item in my_list_ten]

unique_address = []
duplicate_address = []

for addr in my_list_ten_mem:
    if addr not in unique_address:
        unique_address.append(addr)
    elif addr not in duplicate_address:
        duplicate_address.append(addr)

print("Memory addresses:", my_list_ten_mem)
print("Unique addresses:", unique_address)
print("Duplicate addresses:", duplicate_address)

